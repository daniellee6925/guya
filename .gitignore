# Secrets
.env
.env.*

# Node
node_modules/
**/node_modules/

# OMC runtime state (ephemeral — not meaningful across sessions)
.omc/sessions/
.omc/state/
guya-plugin/.omc/
guya-plugin/hooks/.omc/
guya-plugin/skills/.omc/

# Agent replay logs (ephemeral)
**/.omc/state/*.jsonl

# Pre-commit review gate evidence (ephemeral — the post-commit scribe deletes
# this after every successful commit, so a tracked copy is always stale state)
**/.guya/evolution/review-evidence.jsonl

# State markers
.orphaned_at
**/.orphaned_at

# OS
.DS_Store
**/.DS_Store

# Personal drafts
thoughts.txt
/data/
